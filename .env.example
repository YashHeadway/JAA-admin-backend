# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api

# CORS Allowed Origins (comma separated)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:3001

# Authentication / JWT
JWT_SECRET=jaa_super_secret_jwt_key_2026_secure_token_change_in_production
JWT_EXPIRES_IN=7d

# Database Configuration (MongoDB Compass / local server)
MONGO_URI=mongodb://127.0.0.1:27017/JAA_Backend

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# File Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760 # 10MB in bytes

# Upstash Redis Configuration (Caching)
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token
REDIS_URL=rediss://default:password@endpoint.upstash.io:6379
REDIS_CACHE_ENABLED=true

